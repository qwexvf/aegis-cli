.TH "AEGIS" "1" "May 2026" "aegis 0.1.0-demo" "Aegis Manual"

.SH NAME
aegis-doctor - Sanity-check the local environment (API, cache, allowlist, disk)


.SH SYNOPSIS
\fBaegis doctor [flags]\fP


.SH DESCRIPTION
Sanity-check the local environment (API, cache, allowlist, disk)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for doctor

.PP
\fB--json\fP[=false]
	emit machine-readable JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-v\fP, \fB--verbose\fP[=false]
	enable debug-level structured logging to stderr


.SH SEE ALSO
\fBaegis(1)\fP
