.TH "AEGIS" "1" "May 2026" "aegis 0.1.0-demo" "Aegis Manual"

.SH NAME
aegis-audit - Inspect the local audit log


.SH SYNOPSIS
\fBaegis audit [flags]\fP


.SH DESCRIPTION
Inspect the local audit log


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for audit


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-v\fP, \fB--verbose\fP[=false]
	enable debug-level structured logging to stderr


.SH SEE ALSO
\fBaegis(1)\fP, \fBaegis-audit-tail(1)\fP
