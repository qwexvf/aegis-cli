.TH "AEGIS" "1" "May 2026" "aegis 0.1.0-demo" "Aegis Manual"

.SH NAME
aegis-allowlist-sync - Fetch the org allowlist overlay from the API and cache it locally


.SH SYNOPSIS
\fBaegis allowlist sync [flags]\fP


.SH DESCRIPTION
Fetch the org allowlist overlay from the API and cache it locally


.SH OPTIONS
\fB--force\fP[=false]
	ignore cache freshness and re-fetch

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for sync


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-v\fP, \fB--verbose\fP[=false]
	enable debug-level structured logging to stderr


.SH SEE ALSO
\fBaegis-allowlist(1)\fP
