.TH "AEGIS" "1" "May 2026" "aegis 0.1.0-demo" "Aegis Manual"

.SH NAME
aegis-snapshot-save - Scan the project's lockfile and write aegis.lock at the project root


.SH SYNOPSIS
\fBaegis snapshot save [flags]\fP


.SH DESCRIPTION
Scan the project's lockfile and write aegis.lock at the project root


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for save


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-v\fP, \fB--verbose\fP[=false]
	enable debug-level structured logging to stderr


.SH SEE ALSO
\fBaegis-snapshot(1)\fP
