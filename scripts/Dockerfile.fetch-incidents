# Isolated environment for downloading + neutralizing real malicious packages.
# Runs with no capabilities beyond registry read access.
# Output is written to /incidents-real (mount the host dir here).
#
# Build + run via:
#   make fetch-real-incidents-docker
#
# Or manually:
#   docker build -f scripts/Dockerfile.fetch-incidents -t aegis-fetch-incidents scripts/
#   docker run --rm \
#     -v "$(pwd)/examples/incidents-real:/incidents-real" \
#     aegis-fetch-incidents

FROM node:22-slim

# Install Python + pip + Ruby + gem
RUN apt-get update -q && \
    apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv \
      ruby rubygems \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for extra isolation
RUN useradd -m -s /bin/bash fetcher
USER fetcher
WORKDIR /home/fetcher

# npm: never execute install scripts
RUN npm config set ignore-scripts true

COPY --chown=fetcher:fetcher fetch-real-incidents.sh /home/fetcher/fetch.sh
RUN chmod +x /home/fetcher/fetch.sh

# DEST is where extracted+neutralized packages land (volume-mount the host dir)
ENV DEST=/incidents-real

CMD ["/bin/bash", "/home/fetcher/fetch.sh"]
