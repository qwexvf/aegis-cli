#!/usr/bin/env bash
# Fast pre-push gate — the checks that break CI most often, kept quick enough
# that nobody reaches for --no-verify. The slow gates (lean feature matrix,
# parity goldens) stay in CI only.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass a single push:   git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: cargo fmt --check"
cargo fmt --all --check

echo "pre-push: cargo clippy -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-push: cargo test"
cargo test --workspace

echo "pre-push: ok"
