  <style>
    [data-terminal] code {
      display: block;
      min-height: 1.6em;
    }
    [data-terminal] .term-cursor {
      display: inline-block;
      width: 0.55em;
      height: 1em;
      vertical-align: -2px;
      background: var(--color-fg-strong);
      margin-left: 2px;
      animation: term-blink 1s steps(1) infinite;
    }
    [data-terminal] .term-line {
      opacity: 0;
      transition: opacity 0.18s ease-out;
    }
    [data-terminal] .term-line.term-line-visible {
      opacity: 1;
    }
    [data-terminal] .term-line-prompt {
      color: var(--color-fg-strong);
    }
    [data-terminal] .term-line-output {
      color: var(--color-fg);
    }
    [data-terminal] .term-line-output-strong {
      color: var(--color-fg-strong);
    }
    @keyframes term-blink {
      50% { opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      [data-terminal] .term-cursor { animation: none; opacity: 0; }
      [data-terminal] .term-line { opacity: 1 !important; transition: none; }
    }
  </style>

  <script>
    (() => {
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const blocks = document.querySelectorAll<HTMLPreElement>("[data-terminal]");

      blocks.forEach((pre) => {
        const codeEl = pre.querySelector("code");
        if (!codeEl) return;
        const original = codeEl.textContent ?? "";
        const lines = original.replace(/^\n+|\n+$/g, "").split("\n");
        codeEl.textContent = "";

        const lineEls: { el: HTMLSpanElement; text: string; isPrompt: boolean }[] = [];
        lines.forEach((line, i) => {
          const isPrompt = /^\s*\$\s/.test(line) || /^Run\s/.test(line);
          const isStrong = /^\s*[✓✗◆⚠→#]/.test(line) || /(BLOCK|OK|exit\s+\d)/.test(line);
          const span = document.createElement("span");
          span.className = "term-line " + (isPrompt
            ? "term-line-prompt"
            : isStrong
              ? "term-line-output-strong"
              : "term-line-output");
          codeEl.appendChild(span);
          if (i < lines.length - 1) codeEl.appendChild(document.createTextNode("\n"));
          lineEls.push({ el: span, text: line, isPrompt });
        });

        const cursor = document.createElement("span");
        cursor.className = "term-cursor";
        cursor.style.display = "none";
        codeEl.appendChild(cursor);

        let started = false;
        const run = async () => {
          if (started) return;
          started = true;
          cursor.style.display = "inline-block";

          for (const { el, text, isPrompt } of lineEls) {
            el.classList.add("term-line-visible");
            if (isPrompt && !prefersReduced) {
              for (let i = 0; i < text.length; i++) {
                el.textContent = text.slice(0, i + 1);
                await sleep(18 + Math.random() * 18);
              }
              await sleep(220);
            } else {
              el.textContent = text;
              await sleep(prefersReduced ? 0 : (text.trim() === "" ? 60 : 90));
            }
          }
          await sleep(600);
          cursor.style.display = "none";
        };

        if (prefersReduced) {
          lineEls.forEach(({ el, text }) => {
            el.textContent = text;
            el.classList.add("term-line-visible");
          });
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                run();
                io.disconnect();
              }
            });
          },
          { threshold: 0.25 },
        );
        io.observe(pre);
      });

      function sleep(ms: number) {
        return new Promise((r) => setTimeout(r, ms));
      }
    })();

    // Quick-start ecosystem tabs.
    (() => {
      document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((container) => {
        const buttons = container.querySelectorAll<HTMLButtonElement>("[data-tab-target]");
        const panels = container.querySelectorAll<HTMLElement>("[data-tab-panel]");

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const target = btn.dataset.tabTarget;
            buttons.forEach((b) => (b.dataset.tabActive = b === btn ? "true" : "false"));
            panels.forEach((p) => {
              if (p.dataset.tabPanel === target) {
                p.classList.remove("hidden");
                p.classList.add("block");
              } else {
                p.classList.add("hidden");
                p.classList.remove("block");
              }
            });
          });
        });
      });
    })();
  </script>
</BaseLayout>
